{
  "manifest_version": 3,
  "name": "LinkedIn Message Tracker",
  "version": "1.2.0",
  "description": "Conta mensagens enviadas manualmente no LinkedIn e registra no painel LinkedIn Message Tracker.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://project--275e3dec-0801-4821-952e-33dbf781aafe.lovable.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
